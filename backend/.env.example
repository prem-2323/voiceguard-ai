APP_NAME=VoiceGuard AI API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/voiceguard.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
JWT_SECRET=replace-with-a-private-random-secret-of-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
WHISPER_MODEL_PATH=
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_MAX_AUDIO_MB=20
